    {
      "name": "Register User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "const uniqueEmail = `user.${now}@example.com`;",
              "const username = `user_${now}`;",
              "pm.collectionVariables.set('email', uniqueEmail);",
              "pm.collectionVariables.set('updatedUsername', username);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.expect(body.accessToken).to.be.a('string');",
              "pm.expect(body.refreshToken).to.eql(undefined);",
              "const setCookieHeaders = pm.response.headers.all().filter((h) => h.key.toLowerCase() === 'set-cookie');",
              "const refreshCookieHeader = setCookieHeaders.map((h) => h.value).find((value) => value.startsWith('refreshToken='));",
              "pm.expect(refreshCookieHeader).to.be.a('string');",
              "const refreshToken = refreshCookieHeader.split(';')[0].slice('refreshToken='.length);",
              "pm.expect(refreshToken).to.be.a('string');",
              "pm.collectionVariables.set('refreshToken', refreshToken);",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
