{
  "info": {
    "name": "Campaign Manager Flow - Campaigns",
    "_postman_id": "00000000-0000-4000-8000-00007f529d9f",
    "description": "End-to-end campaign lifecycle flow. Creates its own owner user and exercises owner-only campaign operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Owner",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ownerEmail', `owner.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Create Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('campaignId', body.id);",
              "pm.expect(body.role).to.eql('OWNER');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{campaignName}}\",\n  \"visibility\": \"PRIVATE\",\n  \"worldName\": \"Faerun\",\n  \"startingLevel\": 1\n}"
        }
      },
      "response": []
    },
    {
      "name": "Update Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{updatedCampaignName}}\",\n  \"visibility\": \"PUBLIC_READ_ONLY\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Create Cover Image Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('coverImageKey', body.coverImageKey);",
              "pm.expect(body.coverImageUrl).to.include('/campaigns/' + pm.collectionVariables.get('campaignId') + '/cover-images/');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/cover-image-upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "cover-image-upload"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"cover.webp\",\n  \"contentType\": \"image/webp\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Archive Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/archive",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "archive"
          ]
        }
      },
      "response": []
    },
