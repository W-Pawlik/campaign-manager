          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "restore"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}",
          "host": [
