    {
      "name": "Create Campaign",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('campaignId', pm.response.json().id);"
            ]
