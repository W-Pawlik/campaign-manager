        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{invitedUserId}}\",\n  \"role\": \"PLAYER\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "List Invitations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const invitation = pm.response.json().find((entry) => entry.userId === pm.collectionVariables.get('invitedUserId') && entry.status === 'INVITED');",
              "pm.expect(invitation).to.not.eql(undefined);",
              "pm.collectionVariables.set('invitationId', invitation.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/invitations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "invitations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Accept Invitation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{invitedAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/invitations/{{invitationId}}/accept",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "invitations",
            "{{invitationId}}",
            "accept"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Members",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const member = pm.response.json().find((entry) => entry.userId === pm.collectionVariables.get('invitedUserId'));",
              "pm.expect(member.status).to.eql('ACTIVE');",
              "pm.collectionVariables.set('memberId', member.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Change Member Role",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/{{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members",
            "{{memberId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"OBSERVER\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Remove Member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
