        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/invite",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members",
