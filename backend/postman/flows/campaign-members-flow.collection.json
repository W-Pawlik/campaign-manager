    {
      "name": "Transfer Ownership",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/{{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members",
            "{{memberId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"OWNER\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Verify Ownership Transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const members = pm.response.json();",
              "const newOwner = members.find((entry) => entry.userId === pm.collectionVariables.get('invitedUserId'));",
              "const previousOwner = members.find((entry) => entry.userId === pm.collectionVariables.get('ownerUserId'));",
              "pm.expect(newOwner.role).to.eql('OWNER');",
              "pm.expect(previousOwner.role).to.eql('GM');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{invitedAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members"
          ]
        }
      },
      "response": []
