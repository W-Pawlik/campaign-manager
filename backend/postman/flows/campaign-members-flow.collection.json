    {
      "name": "List Members After Reinvite",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const member = pm.response.json().find((entry) => entry.userId === pm.collectionVariables.get('invitedUserId') && entry.status === 'ACTIVE');",
              "pm.expect(member.role).to.eql('CO_GM');",
              "pm.collectionVariables.set('memberId', member.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerAccessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "campaigns",
            "{{campaignId}}",
            "members"
          ]
        }
      },
      "response": []
