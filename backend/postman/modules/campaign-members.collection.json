{
  "info": {
    "name": "Campaign Manager - Campaign Members",
    "_postman_id": "00000000-0000-4000-8000-00007e901601",
    "description": "Module collection for campaign members and invitations. Requires campaignId and the appropriate owner, staff or invited-user token depending on the request. Listing members and invitations plus inviting members require staff access, while role changes, ownership transfer and member removal require owner access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Members",
      "item": [
        {
          "name": "List Campaign Members",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(Array.isArray(pm.response.json())).to.eql(true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campaigns",
                "{{campaignId}}",
                "members"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Invite Campaign Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('invitationId', body.id);",
                  "pm.expect(body.userId).to.eql(pm.collectionVariables.get('invitedUserId'));",
                  "pm.expect(body.role).to.eql('PLAYER');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/invite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campaigns",
                "{{campaignId}}",
                "members",
                "invite"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{invitedUserId}}\",\n  \"role\": \"PLAYER\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Change Campaign Member Role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campaigns",
                "{{campaignId}}",
                "members",
                "{{memberId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"OBSERVER\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Transfer Campaign Ownership",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campaigns",
                "{{campaignId}}",
                "members",
                "{{memberId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"OWNER\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Remove Campaign Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/members/{{memberId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campaigns",
                "{{campaignId}}",
                "members",
                "{{memberId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invitations",
      "item": [
        {
          "name": "List Campaign Invitations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const invitations = pm.response.json();",
                  "pm.expect(Array.isArray(invitations)).to.eql(true);",
                  "if (invitations.length > 0) { pm.collectionVariables.set('invitationId', invitations[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/invitations",
