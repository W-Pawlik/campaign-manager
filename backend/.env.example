APP_ENV=development
LOG_LEVEL=info
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campaign_manager
REDIS_URL=redis://localhost:6379
AUTH_ACCESS_TOKEN_ACTIVE_KID=access-v2
AUTH_ACCESS_TOKEN_ACTIVE_SECRET=change-me-access-secret-v2
AUTH_ACCESS_TOKEN_PREVIOUS_KID=access-v1
AUTH_ACCESS_TOKEN_PREVIOUS_SECRET=change-me-access-secret-v1
AUTH_REFRESH_TOKEN_ACTIVE_KID=refresh-v2
AUTH_REFRESH_TOKEN_ACTIVE_SECRET=change-me-refresh-secret-v2
AUTH_REFRESH_TOKEN_PREVIOUS_KID=refresh-v1
AUTH_REFRESH_TOKEN_PREVIOUS_SECRET=change-me-refresh-secret-v1
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AWS_REGION=eu-central-1
AWS_S3_BUCKET=campaign-manager-local
