generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  username            String           @unique
  displayName         String
  passwordHash        String
  avatarUrl           String?
  bio                 String?
  timezone            String?
  locale              String?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  sessions            UserSession[]
  profile             UserProfile?
  campaignMemberships CampaignMember[]
  ownedCampaigns      Campaign[]
  ownedCharacters     Character[]         @relation("CharacterOwner")
  createdNpcs         Npc[]               @relation("NpcCreator")
  createdLocations    Location[]          @relation("LocationCreator")
  authoredNotes       Note[]              @relation("NoteAuthor")
  sentCampaignInvites CampaignMember[] @relation("CampaignMemberInvitedBy")
  campaignInvitations CampaignInvitation[] @relation("CampaignInvitationUser")
  sentInvitations     CampaignInvitation[] @relation("CampaignInvitationInvitedBy")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  preferredSystem String?
  defaultTimezone String?
  socialLinks     Json?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String   @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Campaign {
  id                 String           @id
  ownerId            String
  name               String
  slug               String           @unique
  description        String?
  gameSystemId       String?
  status             String
  visibility         String
  coverImageUrl      String?
  coverImageKey      String?
  defaultLanguage    String?
  currentDateInWorld String?
  worldName          String?
  startingLevel      Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  archivedAt         DateTime?
  deletedAt          DateTime?
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members            CampaignMember[]
  invitations        CampaignInvitation[]
  characters         Character[]
  npcs               Npc[]
  locations          Location[]
  notes              Note[]

  @@index([ownerId])
  @@index([status])
  @@map("campaigns")
}

model CampaignInvitation {
  id          String   @id
  campaignId  String
  userId      String
  role        String
  status      String
  invitedById String
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation("CampaignInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("CampaignInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@unique([campaignId, userId, status])
  @@map("campaign_invitations")
}

model CampaignMember {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  role        String
  status      String    @default("ACTIVE")
  nickname    String?
  joinedAt    DateTime?
  invitedAt   DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("CampaignMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([status])
  @@index([userId])
  @@index([campaignId])
  @@index([invitedById])
  @@map("campaign_members")
}

model Character {
  id                     String    @id
  campaignId             String
  ownerUserId            String?
  sheetTemplateId        String?
  name                   String
  avatarUrl              String?
  type                   String
  status                 String
  race                   String?
  characterClass         String?
  subclass               String?
  level                  Int?
  background             String?
  alignment              String?
  experiencePoints       Int?
  armorClass             Int?
  initiativeBonus        Int?
  speed                  String?
  maxHitPoints           Int?
  currentHitPoints       Int?
  temporaryHitPoints     Int?
  hitDice                String?
  strength               Int?
  dexterity              Int?
  constitution           Int?
  intelligence           Int?
  wisdom                 Int?
  charisma               Int?
  proficiencyBonus       Int?
  savingThrows           Json?
  skills                 Json?
  proficiencies          Json?
  languages              Json?
  attacksAndSpellcasting Json?
  spellcasting           Json?
  featuresAndTraits      Json?
  personalityTraits      String?
  ideals                 String?
  bonds                  String?
  flaws                  String?
  backstory              String?
  appearance             String?
  customData             Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  campaign               Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner                  User?     @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([ownerUserId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("characters")
}

model Npc {
  id                  String    @id
  campaignId          String
  name                String
  title               String?
  avatarUrl           String?
  race                String?
  occupation          String?
  faction             String?
  locationId          String?
  attitude            String
  importance          String
  status              String
  publicDescription   String?
  gmNotes             String?
  appearance          String?
  personality         String?
  motivations         String?
  secrets             String?
  statBlock           Json?
  externalReferenceId String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy           User      @relation("NpcCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([locationId])
  @@index([createdById])
  @@index([status])
  @@index([importance])
  @@index([deletedAt])
  @@map("npcs")
}

model Location {
  id               String    @id
  campaignId       String
  parentLocationId String?
  name             String
  type             String
  shortDescription String?
  description      String?
  gmNotes          String?
  mapImageUrl      String?
  coordinates      Json?
  status           String
  visibility       String
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentLocation   Location? @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations   Location[] @relation("LocationHierarchy")
  createdBy        User      @relation("LocationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([parentLocationId])
  @@index([createdById])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("locations")
}

model Note {
  id                String    @id
  campaignId        String
  authorId          String
  title             String?
  content           String
  visibility        String
  category          String
  relatedEntityType String?
  relatedEntityId   String?
  isPinned          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author            User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([authorId])
  @@index([visibility])
  @@index([category])
  @@index([relatedEntityType, relatedEntityId])
  @@index([isPinned])
  @@index([deletedAt])
  @@map("notes")
}
