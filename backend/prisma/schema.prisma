generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  username            String           @unique
  passwordHash        String
  avatarUrl           String?
  bio                 String?
  timezone            String?
  locale              String?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  sessions            UserSession[]
  profile             UserProfile?
  campaignMemberships CampaignMember[]
  ownedCampaigns      Campaign[]
  ownedCharacters     Character[]         @relation("CharacterOwner")
  createdMonsters     Monster[]           @relation("MonsterCreator")
  createdNpcs         Npc[]               @relation("NpcCreator")
  createdLocations    Location[]          @relation("LocationCreator")
  authoredNotes       Note[]              @relation("NoteAuthor")
  gameSessions        GameSession[]       @relation("GameSessionCreator")
  sessionParticipants SessionParticipant[] @relation("SessionParticipantUser")
  createdChronicleEntries ChronicleEntry[] @relation("ChronicleEntryCreator")
  createdQuests       Quest[]             @relation("QuestCreator")
  sentCampaignInvites CampaignMember[] @relation("CampaignMemberInvitedBy")
  campaignInvitations CampaignInvitation[] @relation("CampaignInvitationUser")
  sentInvitations     CampaignInvitation[] @relation("CampaignInvitationInvitedBy")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  preferredSystem String?
  defaultTimezone String?
  socialLinks     Json?
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String   @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Campaign {
  id                 String           @id
  ownerId            String
  name               String
  slug               String           @unique
  description        String?
  gameSystemId       String?
  status             String
  visibility         String
  coverImageUrl      String?
  coverImageKey      String?
  defaultLanguage    String?
  currentDateInWorld String?
  worldName          String?
  startingLevel      Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  archivedAt         DateTime?
  deletedAt          DateTime?
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members            CampaignMember[]
  invitations        CampaignInvitation[]
  characters         Character[]
  npcs               Npc[]
  locations          Location[]
  notes              Note[]
  gameSessions       GameSession[]
  chronicleEntries   ChronicleEntry[]
  quests             Quest[]
  inventoryItems     InventoryItem[]
  monsters           Monster[]

  @@index([ownerId])
  @@index([status])
  @@map("campaigns")
}

model CampaignInvitation {
  id          String   @id
  campaignId  String
  userId      String
  role        String
  status      String
  invitedById String
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation("CampaignInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("CampaignInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@unique([campaignId, userId, status])
  @@map("campaign_invitations")
}

model ExternalReference {
  id                 String   @id @default(uuid())
  provider           String
  resourceType       String
  externalId         String?
  key                String?
  slug               String?
  url                String?
  name               String
  sourceDocumentKey  String?
  sourceDocumentName String?
  rawData            Json
  normalizedData     Json?
  cachedAt           DateTime
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([provider, resourceType, key])
  @@index([provider, resourceType])
  @@index([name])
  @@index([sourceDocumentKey])
  @@map("external_references")
}

model CampaignMember {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  role        String
  status      String    @default("ACTIVE")
  nickname    String?
  joinedAt    DateTime?
  invitedAt   DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("CampaignMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([status])
  @@index([userId])
  @@index([campaignId])
  @@index([invitedById])
  @@map("campaign_members")
}

model Character {
  id                     String    @id
  campaignId             String
  ownerUserId            String?
  sheetTemplateId        String?
  name                   String
  avatarUrl              String?
  type                   String
  status                 String
  race                   String?
  characterClass         String?
  subclass               String?
  level                  Int?
  background             String?
  alignment              String?
  experiencePoints       Int?
  armorClass             Int?
  initiativeBonus        Int?
  speed                  String?
  maxHitPoints           Int?
  currentHitPoints       Int?
  temporaryHitPoints     Int?
  hitDice                String?
  strength               Int?
  dexterity              Int?
  constitution           Int?
  intelligence           Int?
  wisdom                 Int?
  charisma               Int?
  proficiencyBonus       Int?
  savingThrows           Json?
  skills                 Json?
  proficiencies          Json?
  languages              Json?
  attacksAndSpellcasting Json?
  spellcasting           Json?
  featuresAndTraits      Json?
  personalityTraits      String?
  ideals                 String?
  bonds                  String?
  flaws                  String?
  backstory              String?
  appearance             String?
  customData             Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  campaign               Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner                  User?     @relation("CharacterOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([ownerUserId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("characters")
}

model Npc {
  id                  String    @id
  campaignId          String
  name                String
  title               String?
  avatarUrl           String?
  race                String?
  occupation          String?
  faction             String?
  locationId          String?
  attitude            String
  importance          String
  status              String
  publicDescription   String?
  gmNotes             String?
  appearance          String?
  personality         String?
  motivations         String?
  secrets             String?
  statBlock           Json?
  externalReferenceId String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy           User      @relation("NpcCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([locationId])
  @@index([createdById])
  @@index([status])
  @@index([importance])
  @@index([deletedAt])
  @@map("npcs")
}

model Monster {
  id                    String    @id
  campaignId            String?
  gameSystemId          String?
  source                String
  externalReferenceId   String?
  name                  String
  slug                  String
  size                  String?
  type                  String?
  subtype               String?
  alignment             String?
  armorClass            Int?
  armorClassDetails     String?
  hitPoints             Int?
  hitDice               String?
  speed                 Json?
  strength              Int?
  dexterity             Int?
  constitution          Int?
  intelligence          Int?
  wisdom                Int?
  charisma              Int?
  savingThrows          Json?
  skills                Json?
  damageResistances     Json?
  damageImmunities      Json?
  conditionImmunities   Json?
  damageVulnerabilities Json?
  senses                String?
  languages             String?
  challengeRating       String?
  challengeRatingDecimal Float?
  proficiencyBonus      Int?
  xp                    Int?
  traits                Json?
  actions               Json?
  bonusActions          Json?
  reactions             Json?
  legendaryActions      Json?
  lairActions           Json?
  regionalEffects       Json?
  spellcasting          Json?
  description           String?
  sourceBook            String?
  pageNumber            String?
  visibility            String
  status                String
  rawData               Json?
  customData            Json?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  campaign              Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy             User?     @relation("MonsterCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([campaignId, slug])
  @@index([campaignId])
  @@index([source])
  @@index([externalReferenceId])
  @@index([name])
  @@index([challengeRatingDecimal])
  @@index([type])
  @@index([deletedAt])
  @@map("monsters")
}

model Location {
  id               String    @id
  campaignId       String
  parentLocationId String?
  name             String
  type             String
  shortDescription String?
  description      String?
  gmNotes          String?
  mapImageUrl      String?
  coordinates      Json?
  status           String
  visibility       String
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentLocation   Location? @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  childLocations   Location[] @relation("LocationHierarchy")
  createdBy        User      @relation("LocationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([parentLocationId])
  @@index([createdById])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("locations")
}

model Note {
  id                String    @id
  campaignId        String
  authorId          String
  title             String?
  content           String
  visibility        String
  category          String
  relatedEntityType String?
  relatedEntityId   String?
  isPinned          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author            User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([authorId])
  @@index([visibility])
  @@index([category])
  @@index([relatedEntityType, relatedEntityId])
  @@index([isPinned])
  @@index([deletedAt])
  @@map("notes")
}

model GameSession {
  id               String      @id
  campaignId       String
  title            String
  description      String?
  status           String
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  locationType     String?
  locationDetails  String?
  meetingUrl       String?
  summaryPublic    String?
  summaryPrivate   String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cancelledAt      DateTime?
  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy        User        @relation("GameSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants     SessionParticipant[]
  chronicleEntries ChronicleEntry[]

  @@index([campaignId])
  @@index([createdById])
  @@index([status])
  @@index([scheduledStartAt])
  @@index([cancelledAt])
  @@map("game_sessions")
}

model SessionParticipant {
  id               String      @id
  sessionId        String
  userId           String
  characterId      String?
  attendanceStatus String
  note             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  session          GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User        @relation("SessionParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([characterId])
  @@index([attendanceStatus])
  @@map("session_participants")
}

model ChronicleEntry {
  id          String    @id
  campaignId  String
  sessionId   String?
  title       String
  content     String
  inWorldDate String?
  occurredAt  DateTime?
  visibility  String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session     GameSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("ChronicleEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([sessionId])
  @@index([createdById])
  @@index([visibility])
  @@index([occurredAt])
  @@map("chronicle_entries")
}

model Quest {
  id                String    @id
  campaignId        String
  title             String
  description       String?
  status            String
  type              String
  visibility        String
  priority          String
  giverNpcId        String?
  relatedLocationId String?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  rewardDescription String?
  gmNotes           String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy         User      @relation("QuestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  objectives        QuestObjective[]
  relations         QuestRelation[]

  @@index([campaignId])
  @@index([status])
  @@index([visibility])
  @@index([createdById])
  @@index([giverNpcId])
  @@index([relatedLocationId])
  @@index([deletedAt])
  @@map("quests")
}

model QuestObjective {
  id          String   @id
  questId      String
  title       String
  description String?
  status      String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@index([status])
  @@index([sortOrder])
  @@map("quest_objectives")
}

model QuestRelation {
  id           String   @id
  questId      String
  entityType   String
  entityId     String
  relationType String
  createdAt    DateTime @default(now())
  quest        Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@index([entityType, entityId])
  @@unique([questId, entityType, entityId, relationType])
  @@map("quest_relations")
}

model ItemTemplate {
  id                  String   @id
  source              String
  externalReferenceId String?
  name                String
  type                String
  rarity              String?
  isMagical           Boolean  @default(false)
  description         String?
  properties          Json?
  weight              Float?
  valueAmount         Float?
  valueCurrency       String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([source])
  @@index([type])
  @@map("item_templates")
}

model InventoryItem {
  id               String   @id
  campaignId       String
  itemTemplateId   String?
  source           String   @default("CUSTOM")
  externalReferenceId String?
  name             String
  type             String   @default("OTHER")
  rarity           String?
  isMagical        Boolean  @default(false)
  description      String?
  weight           Float?
  valueAmount      Float?
  valueCurrency    String?
  quantity         Int
  charges          Int?
  maxCharges       Int?
  isEquipped       Boolean  @default(false)
  isAttuned        Boolean  @default(false)
  isIdentified     Boolean  @default(true)
  ownerType        String
  ownerId          String
  visibility       String
  customProperties Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([itemTemplateId])
  @@index([ownerType, ownerId])
  @@index([visibility])
  @@index([deletedAt])
  @@map("inventory_items")
}
